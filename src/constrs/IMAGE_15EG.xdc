# ----------------------------------------------------------------------------------
# 10G SFP1 Transceiver Constraints (Bank 129)
# ----------------------------------------------------------------------------------
# The GT transceiver pins (gt_rx_p/n, gt_tx_p/n) and mgtrefclk_p/n are dedicated
# hardware pins on Bank 129. Vivado block automation using QUAD_129 places 
# them automatically, so explicit PACKAGE_PIN definitions for RX/TX/CLK are usually
# not provided. The 156.25MHz reference clock should be MGTREFCLK0 129.

# ==================================================================================
# 4-Channel SFP Transceiver Control (TX Disable) hardware tie-off (Tied to Constant 0)
# ==================================================================================
# Since these signals are on Bank 49 which operates on a 3.3V VCCO (as verified by 
# UART_1_0_rxd and EMIO_tri_io[10-15] also present in Bank 49), they must use LVCMOS33.
# By driving these low (0) in Block Design via sfp_en_logic, the hardware permanently
# enables the SFP lasers for optical transmission.

set_property PACKAGE_PIN A12 [get_ports sfp1_tx_dis]
set_property IOSTANDARD LVCMOS33 [get_ports sfp1_tx_dis]

set_property PACKAGE_PIN B14 [get_ports sfp2_tx_dis]
set_property IOSTANDARD LVCMOS33 [get_ports sfp2_tx_dis]

set_property PACKAGE_PIN A13 [get_ports sfp1_loss]
set_property IOSTANDARD LVCMOS33 [get_ports sfp1_loss]
set_property PULLDOWN TRUE [get_ports sfp1_loss]

set_property PACKAGE_PIN A15 [get_ports sfp3_tx_dis]
set_property IOSTANDARD LVCMOS33 [get_ports sfp3_tx_dis]

set_property PACKAGE_PIN A16 [get_ports sfp4_tx_dis]
set_property IOSTANDARD LVCMOS33 [get_ports sfp4_tx_dis]

set_property PACKAGE_PIN L27 [get_ports sfp1_refclk_clk_p]
set_property PACKAGE_PIN L28 [get_ports sfp1_refclk_clk_n]


# PL LED (Bank49, 由PL GPIO驱动, R5固件控制)
set_property PACKAGE_PIN D16 [get_ports {PL_LED_tri_o[0]}]
set_property PACKAGE_PIN C16 [get_ports {PL_LED_tri_o[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {PL_LED_tri_o[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {PL_LED_tri_o[1]}]

# EMIO[3]/[4] 原占用 D16/C16（已改作 PL LED），现哑元到 bank49 未用引脚
# 复位时为 GPIO 输入态（高阻），仅占位满足 DRC
set_property PACKAGE_PIN B15 [get_ports {EMIO_tri_io[3]}]
set_property PACKAGE_PIN B16 [get_ports {EMIO_tri_io[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {EMIO_tri_io[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {EMIO_tri_io[4]}]

# EMIO[15] 原占用 F12（已改由 PL pwrgd 端口驱动），同样哑元占位
# 注：C15 是 GND 脚，C14 为 bank49 真实 IO 且两版设计均未使用
set_property PACKAGE_PIN C14 [get_ports {EMIO_tri_io[15]}]
set_property IOSTANDARD LVCMOS33 [get_ports {EMIO_tri_io[15]}]

# ----------------------------------------------------------------------------------
# MIPI CSI-2 camera (OV5647) constraints
# ----------------------------------------------------------------------------------
# D-PHY 差分对（bank 67，HP bank 1.8V）不需要 XDC 约束：
# MIPI CSI-2 Rx Subsystem 的 D-PHY 引脚位置是 IP 参数（见 tcl/02c_mipi_csi.tcl
# 的 CONFIG.CLK_LANE_IO_LOC / DATA_LANE*_IO_LOC），IP 自带 IOSTANDARD 约束：
#   MIPI1_CLK_P/N  = W12/W11 (B67_L1)   MIPI1_LAN0_P/N = T13/R13 (B67_L2)
#   MIPI1_LAN1_P/N = U10/T10 (B67_L3)
#
# 传感器 I2C 约束（CAM_SCL/CAM_SDA）已移至 src/constrs/mipi_cam.xdc，
# 仅在 ENABLE_MIPI=1 构建时加入（对应端口由 tcl/02c_mipi_csi.tcl 创建）。

# CAM1_CLK(G16)/CAM1_GPIO(H16) 已被 EMIO_tri_io[8]/[9] 占用（见上文）。
# 树莓派兼容 OV5647 模组自带晶振（xvclk 25MHz 由 DT fixed-clock 声明），
# LED 线不需要驱动，故不额外处理。
