/include/ "system-conf.dtsi"
/ {
	chosen {
		bootargs = "console=ttyPS0,115200 earlycon root=/dev/mmcblk1p2 rw rootwait";
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		ps_led1 {
			label = "PS_LED1";
			gpios = <&gpio 35 0>; /* MIO35, Active High */
			default-state = "off";
		};

		ps_led2 {
			label = "PS_LED2";
			gpios = <&gpio 26 0>; /* MIO26, Active High */
			default-state = "off";
		};

		ps_led3 {
			label = "PS_LED3";
			gpios = <&gpio 31 0>; /* MIO31, Active High */
			linux,default-trigger = "heartbeat";
		};

		ps_led4 {
			label = "PS_LED4";
			gpios = <&gpio 41 0>; /* MIO41, Active High */
			default-state = "on";
		};
	};

	tcm_0a: tcm@ffe00000 {
		compatible = "mmio-sram";
		reg = <0x0 0xffe00000 0x0 0x10000>;
		power-domain = <&zynqmp_firmware 15>;
	};

	tcm_0b: tcm@ffe20000 {
		compatible = "mmio-sram";
		reg = <0x0 0xffe20000 0x0 0x10000>;
		power-domain = <&zynqmp_firmware 16>;
	};

	tcm_1a: tcm@ffe90000 {
		compatible = "mmio-sram";
		reg = <0x0 0xffe90000 0x0 0x10000>;
		power-domain = <&zynqmp_firmware 17>;
	};

	tcm_1b: tcm@ffeb0000 {
		compatible = "mmio-sram";
		reg = <0x0 0xffeb0000 0x0 0x10000>;
		power-domain = <&zynqmp_firmware 18>;
	};

	rpu: rpu@ff9a0000 {
		compatible = "xlnx,zynqmp-r5-remoteproc";
		xlnx,cluster-mode = <1>; /* split：双核独立运行（0=lockstep，1=split） */
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		r5_0: r5@0 {
			compatible = "xlnx,zynqmp-r5-remoteproc";
			sram = <&tcm_0a>, <&tcm_0b>;
			power-domain = <&zynqmp_firmware 7>;
			mboxes = <&ipi_mailbox_rpu0 0>, <&ipi_mailbox_rpu0 1>;
			mbox-names = "tx", "rx";
		};

		r5_1: r5@1 {
			compatible = "xlnx,zynqmp-r5-remoteproc";
			sram = <&tcm_1a>, <&tcm_1b>;
			power-domain = <&zynqmp_firmware 8>;
			mboxes = <&ipi_mailbox_rpu1 0>, <&ipi_mailbox_rpu1 1>;
			mbox-names = "tx", "rx";
		};
	};

	/* AD9361 参考时钟占位：40MHz。实际时钟源（核心板 AD9523-1 或 FMCOMMS3 卡上
	 * AD9523）需按原理图核实后替换为 ad9523 时钟驱动节点 */
	ad9361_clkin: ad9361-clkin {
		compatible = "fixed-clock";
		clock-frequency = <40000000>;
		clock-output-names = "ad9361_ext_refclk";
		#clock-cells = <0>;
	};

	/* OV5647 XVCLK 25MHz：树莓派兼容模组自带晶振，驱动只读频率做 PLL 计算
	 * (ov5647.c 要求严格 25MHz)，不驱动引脚 */
	cam_xvclk: cam-xvclk {
		compatible = "fixed-clock";
		clock-frequency = <25000000>;
		#clock-cells = <0>;
	};

	/* MIPI V4L2 采集管线容器（xlnx,video）：frmbuf DMA 通道 + media graph 根 */
	vcap_mipi: vcap-mipi {
		compatible = "xlnx,video";
		dmas = <&mipi_frmbuf_wr 0>;
		dma-names = "port0";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				direction = "input";
				vcap_mipi_in0: endpoint {
					remote-endpoint = <&mipi_demosaic_out>;
				};
			};
		};
	};

	/* AD9361 PL 数据通路（地址与 tcl/02b_ad9361.tcl 一致） */
	fpga_axi: fpga-axi@0 {
		interrupt-parent = <&gic>;
		compatible = "simple-bus";
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		rx_dma: dma@80110000 {
			compatible = "adi,axi-dmac-1.00.a";
			reg = <0x0 0x80110000 0x0 0x10000>;
			#dma-cells = <1>;
			#clock-cells = <0>;
			/* xlconcat_0 In4 -> pl_ps_irq0[4] = GIC SPI 93 */
			interrupts = <0 93 4>;
			clocks = <&zynqmp_clk 71>;

			adi,channels {
				#size-cells = <0>;
				#address-cells = <1>;

				dma-channel@0 {
					reg = <0>;
					adi,source-bus-width = <64>;
					adi,source-bus-type = <2>;
					adi,destination-bus-width = <64>;
					adi,destination-bus-type = <0>;
				};
			};
		};

		tx_dma: dma@80120000 {
			compatible = "adi,axi-dmac-1.00.a";
			reg = <0x0 0x80120000 0x0 0x10000>;
			#dma-cells = <1>;
			#clock-cells = <0>;
			/* xlconcat_0 In5 -> pl_ps_irq0[5] = GIC SPI 94 */
			interrupts = <0 94 4>;
			clocks = <&zynqmp_clk 71>;

			adi,channels {
				#size-cells = <0>;
				#address-cells = <1>;

				dma-channel@0 {
					reg = <0>;
					adi,source-bus-width = <64>;
					adi,source-bus-type = <0>;
					adi,destination-bus-width = <64>;
					adi,destination-bus-type = <1>;
				};
			};
		};

		cf_ad9361_adc_core_0: cf-ad9361-lpc@80100000 {
			compatible = "adi,axi-ad9361-6.00.a";
			reg = <0x0 0x80100000 0x0 0x6000>;
			dmas = <&rx_dma 0>;
			dma-names = "rx";
			spibus-connected = <&adc0_ad9361>;
		};

		cf_ad9361_dac_core_0: cf-ad9361-dds-core-lpc@80104000 {
			compatible = "adi,axi-ad9361-dds-6.00.a";
			reg = <0x0 0x80104000 0x0 0x1000>;
			clocks = <&adc0_ad9361 13>;
			clock-names = "sampl_clk";
			dmas = <&tx_dma 0>;
			dma-names = "tx";
		};

		/* ===== MIPI CSI-2 摄像头 (OV5647) —— 地址/中断与 tcl/02c_mipi_csi.tcl 一致 =====
		 * 链路: ov5647(SBGGR10) -> csi2rx -> demosaic(RGB30) -> frmbuf -> HP3
		 * 中断走 xlconcat_1 -> pl_ps_irq1[0..2] = GIC SPI 167/168/169
		 * 时钟: 71=pl_clk0(100M 控制) 72=pl_clk1(300M 视频)
		 */
		mipi_csi2rx: csi2rx@80130000 {
			compatible = "xlnx,mipi-csi2-rx-subsystem-5.0";
			reg = <0x0 0x80130000 0x0 0x10000>;
			interrupts = <0 167 4>;
			clocks = <&zynqmp_clk 71>, <&zynqmp_clk 72>;
			clock-names = "lite_aclk", "video_aclk";
			xlnx,csi-pxl-format = <0x2b>; /* RAW10 */
			xlnx,vfb;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					mipi_csi2rx_in: endpoint {
						data-lanes = <1 2>;
						remote-endpoint = <&ov5647_out>;
					};
				};
				port@1 {
					reg = <1>;
					mipi_csi2rx_out: endpoint {
						remote-endpoint = <&mipi_demosaic_in>;
					};
				};
			};
		};

		mipi_demosaic: demosaic@80140000 {
			compatible = "xlnx,v-demosaic";
			reg = <0x0 0x80140000 0x0 0x10000>;
			clocks = <&zynqmp_clk 72>;
			reset-gpios = <&axi_gpio_mipi_rst 0 1>; /* GPIO_ACTIVE_LOW */
			xlnx,max-width = <3840>;
			xlnx,max-height = <2160>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					xlnx,video-width = <10>;
					mipi_demosaic_in: endpoint {
						remote-endpoint = <&mipi_csi2rx_out>;
					};
				};
				port@1 {
					reg = <1>;
					xlnx,video-width = <10>;
					mipi_demosaic_out: endpoint {
						remote-endpoint = <&vcap_mipi_in0>;
					};
				};
			};
		};

		mipi_frmbuf_wr: frmbuf-wr@80150000 {
			compatible = "xlnx,axi-frmbuf-wr-v2.2"; /* IP 2.4，寄存器兼容 v2.2 */
			#dma-cells = <1>;
			reg = <0x0 0x80150000 0x0 0x10000>;
			interrupts = <0 168 4>;
			clocks = <&zynqmp_clk 72>;
			clock-names = "ap_clk";
			reset-gpios = <&axi_gpio_mipi_rst 1 1>; /* GPIO_ACTIVE_LOW */
			xlnx,vid-formats = "xbgr2101010"; /* V4L2_PIX_FMT_XBGR30 */
			xlnx,max-width = <3840>;
			xlnx,max-height = <2160>;
			xlnx,pixels-per-clock = <1>;
			xlnx,dma-addr-width = <32>;
		};

		cam_iic: i2c@80160000 {
			compatible = "xlnx,xps-iic-2.00.a";
			reg = <0x0 0x80160000 0x0 0x10000>;
			interrupts = <0 169 4>;
			clocks = <&zynqmp_clk 71>;
			#address-cells = <1>;
			#size-cells = <0>;

			ov5647: camera@36 {
				compatible = "ovti,ov5647";
				reg = <0x36>;
				clocks = <&cam_xvclk>;

				port {
					ov5647_out: endpoint {
						data-lanes = <1 2>;
						remote-endpoint = <&mipi_csi2rx_in>;
					};
				};
			};
		};

		/* demosaic/frmbuf 的 ap_rst_n 复位控制（驱动强制要求 reset-gpios，
		 * 位0=demosaic 位1=frmbuf，低有效，见 tcl/02c_mipi_csi.tcl 6b 节） */
		axi_gpio_mipi_rst: gpio@80170000 {
			compatible = "xlnx,axi-gpio-2.0", "xlnx,xps-gpio-1.00.a";
			reg = <0x0 0x80170000 0x0 0x10000>;
			#gpio-cells = <2>;
			gpio-controller;
			clocks = <&zynqmp_clk 71>;
			xlnx,gpio-width = <0x2>;
			xlnx,all-outputs = <0x1>;
		};
	};
};

/* FMC F12（B50_L6_P，板上网络名 PWRGD）：厂商参考设计将其恒定驱动为高。
 * 现由 PL 常量端口 pwrgd 直接驱动（tcl/02b_ad9361.tcl + IMAGE_15EG.xdc），
 * 不再占用 EMIO GPIO，因此无需 hog。
 * 注：RESETB(EMIO[22])/SYNC(EMIO[20]) 由 ad9361 驱动的
 * reset-gpios/sync-gpios 管理，驱动 probe 时自会处理。 */

&zynqmp_ipi {
	ipi_mailbox_rpu0: mailbox@ff990000 {
		reg = <0x0 0xff990400 0x0 0x20>,
		      <0x0 0xff990420 0x0 0x20>,
		      <0x0 0xff990000 0x0 0x20>,
		      <0x0 0xff990020 0x0 0x20>;
		reg-names = "local_request_region",
		            "local_response_region",
		            "remote_request_region",
		            "remote_response_region";
		#mbox-cells = <1>;
		xlnx,ipi-id = <1>;
	};

	ipi_mailbox_rpu1: mailbox@ff990200 {
		reg = <0x0 0xff990400 0x0 0x20>,
		      <0x0 0xff990420 0x0 0x20>,
		      <0x0 0xff990200 0x0 0x20>,
		      <0x0 0xff990220 0x0 0x20>;
		reg-names = "local_request_region",
		            "local_response_region",
		            "remote_request_region",
		            "remote_response_region";
		#mbox-cells = <1>;
		xlnx,ipi-id = <2>;
	};
};

&gpio {
	status = "okay";
};

&gem3 {
	local-mac-address = [00 0a 35 00 00 02];
	phy-handle = <&phy3>;
	phy-mode = "rgmii-id";
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		phy3: phy@0 {
			reg = <0>;
		};
	};
};

&xxv_ethernet_0 {
	local-mac-address = [00 0a 35 00 00 03];
};

&axi_gpio_led {
	status = "disabled"; /* PL LED 由 R5 固件独占控制 */
};

&sdhci1 {
	status = "okay";
	disable-wp;
	no-1-8-v;
};

/* AD9361 SPI + PHY（PS SPI0 via EMIO；配置取自 ADI adi-fmcomms2.dtsi FMCOMMS3） */
&spi0 {
	status = "okay";

	adc0_ad9361: ad9361-phy@0 {
		compatible = "adi,ad9361";
		reg = <0>;

		/* SPI Setup */
		spi-cpha;
		spi-max-frequency = <10000000>;

		/* Clocks */
		clocks = <&ad9361_clkin 0>;
		clock-names = "ad9361_ext_refclk";
		clock-output-names = "rx_sampl_clk", "tx_sampl_clk";
		#clock-cells = <1>;

		/* Control GPIOs（线号 = 78 + EMIO bit，见 IMAGE_15EG.xdc 注释） */
		reset-gpios = <&gpio 100 0>; /* EMIO[22] -> AD9361 RESETB (AB6), 低电平复位 */
		sync-gpios = <&gpio 98 0>;  /* EMIO[20] -> SYNC (U6) */

		/* Digital Interface Control */
		adi,digital-interface-tune-skip-mode = <0>;
		adi,pp-tx-swap-enable;
		adi,pp-rx-swap-enable;
		adi,rx-frame-pulse-mode-enable;
		adi,lvds-mode-enable;
		adi,lvds-bias-mV = <150>;
		adi,lvds-rx-onchip-termination-enable;
		adi,rx-data-delay = <4>;
		adi,tx-fb-clock-delay = <7>;

		adi,dcxo-coarse-and-fine-tune = <8 5920>;

		/* Mode Setup */
		adi,2rx-2tx-mode-enable;

		/* ENSM Mode */
		adi,frequency-division-duplex-mode-enable;

		adi,rx-rf-port-input-select = <0>; /* RX1A/RX2A balanced */
		adi,tx-rf-port-input-select = <0>; /* TX1A/TX2A */
		adi,tx-attenuation-mdB = <10000>;
		adi,tx-lo-powerdown-managed-enable;

		adi,rf-rx-bandwidth-hz = <18000000>;
		adi,rf-tx-bandwidth-hz = <18000000>;
		adi,rx-synthesizer-frequency-hz = /bits/ 64 <2400000000>;
		adi,tx-synthesizer-frequency-hz = /bits/ 64 <2450000000>;

		/*              BBPLL     ADC        R2CLK     R1CLK    CLKRF    RSAMPL  */
		adi,rx-path-clock-frequencies = <983040000 245760000 122880000 61440000 30720000 30720000>;
		/*              BBPLL     DAC        T2CLK     T1CLK    CLKTF    TSAMPL  */
		adi,tx-path-clock-frequencies = <983040000 122880000 122880000 61440000 30720000 30720000>;

		/* Gain Control: Slow Attack AGC */
		adi,gc-rx1-mode = <2>;
		adi,gc-rx2-mode = <2>;
		adi,gc-adc-ovr-sample-size = <4>;
		adi,gc-adc-small-overload-thresh = <47>;
		adi,gc-adc-large-overload-thresh = <58>;
		adi,gc-lmt-overload-high-thresh = <800>;
		adi,gc-lmt-overload-low-thresh = <704>;
		adi,gc-dec-pow-measurement-duration = <8192>;
		adi,gc-low-power-thresh = <24>;
		adi,mgc-inc-gain-step = <2>;
		adi,mgc-dec-gain-step = <2>;
		adi,mgc-split-table-ctrl-inp-gain-mode = <0>;

		/* Automatic Gain Control Setup */
		adi,agc-attack-delay-extra-margin-us = <1>;
		adi,agc-outer-thresh-high = <5>;
		adi,agc-outer-thresh-high-dec-steps = <2>;
		adi,agc-inner-thresh-high = <10>;
		adi,agc-inner-thresh-high-dec-steps = <1>;
		adi,agc-inner-thresh-low = <12>;
		adi,agc-inner-thresh-low-inc-steps = <1>;
		adi,agc-outer-thresh-low = <18>;
		adi,agc-outer-thresh-low-inc-steps = <2>;
		adi,agc-adc-small-overload-exceed-counter = <10>;
		adi,agc-adc-large-overload-exceed-counter = <10>;
		adi,agc-adc-large-overload-inc-steps = <2>;
		adi,agc-lmt-overload-large-exceed-counter = <10>;
		adi,agc-lmt-overload-small-exceed-counter = <10>;
		adi,agc-lmt-overload-large-inc-steps = <2>;
		adi,agc-gain-update-interval-us = <1000>;

		/* Fast AGC */
		adi,fagc-dec-pow-measurement-duration = <64>;
		adi,fagc-lp-thresh-increment-steps = <1>;
		adi,fagc-lp-thresh-increment-time = <5>;
		adi,fagc-energy-lost-stronger-sig-gain-lock-exit-cnt = <8>;
		adi,fagc-final-overrange-count = <3>;
		adi,fagc-gain-index-type-after-exit-rx-mode = <0>;
		adi,fagc-lmt-final-settling-steps = <1>;
		adi,fagc-lock-level = <10>;
		adi,fagc-lock-level-gain-increase-upper-limit = <5>;
		adi,fagc-lock-level-lmt-gain-increase-enable;
		adi,fagc-lpf-final-settling-steps = <1>;
		adi,fagc-optimized-gain-offset = <5>;
		adi,fagc-power-measurement-duration-in-state5 = <64>;
		adi,fagc-rst-gla-engergy-lost-goto-optim-gain-enable;
		adi,fagc-rst-gla-engergy-lost-sig-thresh-below-ll = <10>;
		adi,fagc-rst-gla-engergy-lost-sig-thresh-exceeded-enable;
		adi,fagc-rst-gla-if-en-agc-pulled-high-mode = <0>;
		adi,fagc-rst-gla-large-adc-overload-enable;
		adi,fagc-rst-gla-large-lmt-overload-enable;
		adi,fagc-rst-gla-stronger-sig-thresh-above-ll = <10>;
		adi,fagc-rst-gla-stronger-sig-thresh-exceeded-enable;
		adi,fagc-state-wait-time-ns = <260>;
		adi,fagc-use-last-lock-level-for-set-gain-enable;

		/* RSSI */
		adi,rssi-restart-mode = <3>;
		adi,rssi-delay = <1>;
		adi,rssi-wait = <1>;
		adi,rssi-duration = <1000>;

		/* Control Outputs */
		adi,ctrl-outs-index = <0>;
		adi,ctrl-outs-enable-mask = <0xFF>;

		/* AuxADC Temp Sense Control */
		adi,temp-sense-measurement-interval-ms = <1000>;
		adi,temp-sense-offset-signed = <0xCE>;
		adi,temp-sense-periodic-measurement-enable;

		/* AuxDAC Control */
		adi,aux-dac-manual-mode-enable;
		adi,aux-dac1-default-value-mV = <0>;
		adi,aux-dac1-rx-delay-us = <0>;
		adi,aux-dac1-tx-delay-us = <0>;
		adi,aux-dac2-default-value-mV = <0>;
		adi,aux-dac2-rx-delay-us = <0>;
		adi,aux-dac2-tx-delay-us = <0>;
	};
};
